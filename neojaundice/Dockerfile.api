# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NEOJAUNDICE_APP_ENV=development
WORKDIR /app
# OS dependencies for OpenCV and common image-processing libraries.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README* ./
COPY backend ./backend
COPY ml ./ml
# Install application dependencies from the existing project manifest.
# This requires pyproject.toml to be installable; validate during build.
RUN python -m pip install --upgrade pip && python -m pip install ".[backend,inference]"
RUN groupadd --system app && useradd --system --gid app --home-dir /app app \
    && mkdir -p /app/checkpoints && chown -R app:app /app
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
