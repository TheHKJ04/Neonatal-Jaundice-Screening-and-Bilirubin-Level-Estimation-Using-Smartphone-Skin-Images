# ==========================================
# NeoJaundice Application Configuration
# ==========================================

# Application
APP_NAME=NeoJaundice
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
